# ---------------------------------------------------------------------------
# Invoice Scanner — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (get these from the Supabase dashboard: Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Server-only. Project Settings > API > service_role secret. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# Server-only. Used by the Supabase CLI for migrations / direct Postgres access.
# Project Settings > Database > Database password.
SUPABASE_DB_PASSWORD="your-db-password"

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY="your-gemini-api-key"
# Model used for document extraction. Flash is cheap + multimodal.
GEMINI_MODEL="gemini-3.6-flash"

# --- Inbound email webhook (Phase 2) ---
# Shared secret; the Cloudflare Email Worker signs its POST with this.
INBOUND_EMAIL_SECRET="generate-a-long-random-string"
# Comma-separated list of addresses allowed to forward receipts in.
INBOUND_EMAIL_ALLOWLIST="you@example.com,staff1@example.com,staff2@example.com"

# --- App ---
# Absolute base URL of the deployment (used for redirects / email links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cron endpoints check this against the `Authorization: Bearer` header.
CRON_SECRET="generate-a-long-random-string"

# --- Business defaults (India / Tamil Nadu) ---
NEXT_PUBLIC_HOME_COUNTRY="IN"
# Your GST state code (Tamil Nadu = 33). Drives CGST+SGST vs IGST.
NEXT_PUBLIC_HOME_GST_STATE_CODE="33"
# Your company GSTIN (optional, used to pre-fill exports).
COMPANY_GSTIN=""
